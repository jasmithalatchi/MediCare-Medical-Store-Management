# ==============================================================================
# MediCare Backend - Environment Variables Template
# Copy this file to '.env' and populate with your own secret configuration values.
# NEVER commit your real '.env' file to Git or public repositories.
# ==============================================================================

# Server Environment Mode ('development' or 'production')
NODE_ENV=development

# Server Port (Render, Railway, and Heroku assign this automatically via $PORT)
PORT=5000

# MongoDB Database Connection String
# Local Development: mongodb://127.0.0.1:27017/medicare
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/medicare?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/medicare

# Frontend URL(s) for CORS Whitelist
# For local development: http://localhost:5173
# For production: https://your-medicare-frontend.vercel.app
# Multiple allowed origins can be comma-separated: https://your-site.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret Key
# In production, use a strong 64-character random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=30d

# Initial Administrative Account Credentials (Used by database seed script)
ADMIN_NAME=MediCare Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Initial Demo Customer Account Credentials (Optional seed account)
DEMO_CUSTOMER_NAME=Demo Customer
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=your_secure_customer_password_here
