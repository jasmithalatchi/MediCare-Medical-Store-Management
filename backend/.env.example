# MediCare Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/medicare
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Default Administrative Account Credentials
ADMIN_NAME=MediCare Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Demo Customer Account Credentials
DEMO_CUSTOMER_NAME=Demo Customer
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=your_secure_customer_password_here
