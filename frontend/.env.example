# ==============================================================================
# MediCare Frontend - Environment Variables Template
# Copy this file to '.env' and populate with your environment-specific URL.
# NOTE: Vite variables must be prefixed with 'VITE_' to be exposed to client code.
# ==============================================================================

# Backend API Base URL
# Local Development: http://localhost:5000/api
# Production (Decoupled hosting, e.g. Vercel frontend + Render backend):
#   https://your-medicare-backend.onrender.com/api
# Production (Unified fullstack hosting on single service):
#   /api
VITE_API_BASE_URL=http://localhost:5000/api
