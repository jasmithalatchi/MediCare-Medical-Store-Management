# ==============================================================================
# MediCare Full-Stack System - Unified Environment Template
# ==============================================================================
# Copy this file to '.env' if managing environment variables centrally,
# or set each variable in your respective cloud deployment dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String
# Local: mongodb://127.0.0.1:27017/medicare
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/medicare?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/medicare

# Allowed Client Origin(s) for CORS (Comma-separated for multiple domains)
# Local: http://localhost:5173
# Production: https://your-medicare-app.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# JWT Token Secret & Expiration
# Generate production key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=30d

# Initial Administrator Credentials (Used for database seed script)
ADMIN_NAME=MediCare Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Initial Demo Customer Credentials (Optional)
DEMO_CUSTOMER_NAME=Demo Customer
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=your_secure_customer_password_here

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Local Development: http://localhost:5000/api
# Production Decoupled: https://your-medicare-backend.onrender.com/api
# Production Unified: /api
VITE_API_BASE_URL=http://localhost:5000/api
